# -----------------------------------------------------------------------------
# DATABASE (Managed PostgreSQL via Supabase, Neon, or Render)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:your-db-password@db.xxxx.supabase.co:5432/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-db-password@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Auth, Firestore, Cloud Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="yourSenderId"
NEXT_PUBLIC_FIREBASE_APP_ID="1:yourSenderId:web:yourAppIdHere"

# Firebase Admin SDK (Serverless Backend)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET="tinaye-hub-super-secret-random-64-character-jwt-key"
COOKIE_NAME="tinaye_session"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# STRIPE PAYMENTS ($1/Mo Micro-Subscription & Pay-What-You-Want Donations)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_51xxxx..."
STRIPE_WEBHOOK_SECRET="whsec_xxxx..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51xxxx..."
STRIPE_PRICE_ID_MICRO_1USD="price_1xxxx..."

# -----------------------------------------------------------------------------
# EMAIL DIGEST ENGINE (Resend or SendGrid)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxxx..."
EMAIL_FROM="Tinaye-Hub Reports <reports@tinaye-hub.org>"

# -----------------------------------------------------------------------------
# VERCEL CRON SECURITY
# -----------------------------------------------------------------------------
CRON_SECRET="tinaye-secure-cron-secret-2026"

# -----------------------------------------------------------------------------
# CLIENT & HOST SETTINGS (Port 6000)
# -----------------------------------------------------------------------------
PORT=6000
NEXT_PUBLIC_APP_URL="http://localhost:6000"
